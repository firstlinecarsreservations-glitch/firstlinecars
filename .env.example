# Copier ce fichier en .env.local et renseigner les valeurs.
# .env.local n'est jamais commité (voir .gitignore).

# --- Envoi des demandes de réservation (obligatoire) -----------------
# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=

# Destinataire des demandes. Par défaut :
# firstlinecars.reservations@gmail.com
BOOKING_EMAIL_TO=firstlinecars.reservations@gmail.com

# Expéditeur. Tant que le domaine n'est pas vérifié chez Resend, laisser
# la valeur par défaut "FirstLineCars <onboarding@resend.dev>" — elle ne
# peut écrire QU'À l'adresse du compte Resend. Une fois firstlinecars.ma
# vérifié, utiliser une adresse du domaine pour une meilleure
# délivrabilité :
# BOOKING_EMAIL_FROM="FirstLineCars <reservations@firstlinecars.ma>"
BOOKING_EMAIL_FROM=

# --- Public ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://firstlinecars.ma
NEXT_PUBLIC_WHATSAPP_NUMBER=212700255515
NEXT_PUBLIC_EUR_MAD_EXCHANGE_RATE=10.9
